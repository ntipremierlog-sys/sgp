# ==============================================================================
# SGP — Sistema de Gestão de Postos (Premier Logistics / Petrobras)
# Arquivo de Exemplo de Variáveis de Ambiente
# ==============================================================================

# BANCO DE DADOS (Neon PostgreSQL em São Paulo - aws-sa-east-1 ou Docker Local)
# IMPORTANTE: Em produção (Neon), use a URL com pooling em DATABASE_URL (-pooler)
# e a URL direta em DIRECT_URL para migrations. Localmente com Docker, ambas usam a porta 5432 direta.

# Exemplo Local (Docker Compose):
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/sgp_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/sgp_dev?schema=public"

# Exemplo Produção (Neon em São Paulo):
# DATABASE_URL="postgresql://usuario:senha@ep-xyz-pooler.sa-east-1.aws.neon.tech/sgp_prod?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://usuario:senha@ep-xyz.sa-east-1.aws.neon.tech/sgp_prod?sslmode=require"

# AUTENTICAÇÃO E SESSÃO
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gerar-chave-secreta-com-pelo-menos-32-caracteres-aleatorios"

# SEGURANÇA E CRIPTOGRAFIA EM REPOUSO (AES-256-GCM para CPF e TOTP)
# Chave de 32 bytes em formato hexadecimal (64 caracteres)
CPF_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# AMBIENTE
APP_ENV="development"
NODE_ENV="development"
